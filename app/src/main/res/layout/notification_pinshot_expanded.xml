<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#DE000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notification_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:textColor="#99000000"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/notification_preview_strip"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="10dp"
        android:gravity="start|center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_preview_one"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/notification_thumbnail"
            android:clipToOutline="true"
            android:contentDescription="Screenshot preview"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/notification_preview_two"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="-22dp"
            android:background="@drawable/notification_thumbnail"
            android:clipToOutline="true"
            android:contentDescription="Screenshot preview"
            android:scaleType="centerCrop" />

        <FrameLayout
            android:id="@+id/notification_preview_three_container"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="-22dp"
            android:background="@drawable/notification_thumbnail"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/notification_preview_three"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Screenshot preview"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/notification_more_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:background="@drawable/notification_count_badge"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:textColor="@color/notification_on_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_primary_icon"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:background="@drawable/notification_primary_action"
            android:contentDescription=""
            android:padding="10dp" />

        <TextView
            android:id="@+id/notification_primary_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/notification_primary_action"
            android:gravity="center_vertical"
            android:textColor="@color/notification_on_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/notification_secondary_icon"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@drawable/notification_secondary_action"
            android:contentDescription=""
            android:padding="10dp" />

        <TextView
            android:id="@+id/notification_secondary_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/notification_secondary_action"
            android:gravity="center_vertical"
            android:textColor="@color/notification_on_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
